# === Stage 1: Build the application ===
FROM maven:3.9.12-amazoncorretto-25-alpine AS build
WORKDIR /app

COPY . .

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B clean install -pl user-service-web -am -DskipTests

# === Stage 2: Create the runtime image ===
FROM amazoncorretto:25-alpine-jdk
WORKDIR /app

COPY --from=build /app/user-service-web/target/user-service-web-*.jar app.jar

EXPOSE 8095

ENTRYPOINT ["java", "-jar", "-Dmicronaut.environments=${MICRONAUT_ENVIRONMENTS}", "app.jar"]
